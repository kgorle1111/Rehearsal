# ─────────────────────────────────────────────────────────────────────────────
# Rehearsal — example environment file.  Copy to .env and edit as needed.
#
# The product runs with NONE of these set.  Every value below is either an
# override with a sensible default, or applies only to offline tooling.
# There are no secrets required to run the system, and nothing here is
# transmitted anywhere.  See docs/12-security-privacy.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Models ──────────────────────────────────────────────────────────────────

# Where model weights live.  Defaults to the Hugging Face cache.
# REHEARSAL_MODEL_DIR=~/.cache/huggingface

# Live conversational agents (clinician, patient).  Must be fast — it is on the
# conversational critical path.  Native audio input expected.
# REHEARSAL_LIVE_MODEL=

# Fidelity grader.  Larger model; runs OFF the critical path, so latency is not
# the binding constraint here — accuracy is.
# REHEARSAL_GRADER_MODEL=

# Runtime backend: mlx (Apple Silicon, default) | llamacpp (portable fallback)
# REHEARSAL_RUNTIME=mlx

# ─── Speech ──────────────────────────────────────────────────────────────────

# system (macOS voices) | local (bundled neural TTS)
# REHEARSAL_TTS_BACKEND=system

# Voices for each side of the encounter.
# REHEARSAL_TTS_VOICE_EN=
# REHEARSAL_TTS_VOICE_ES=

# Silence duration (ms) treated as end-of-turn.  Tune per environment; too low
# truncates a thinking trainee, too high makes the encounter feel sluggish.
# REHEARSAL_ENDPOINT_SILENCE_MS=900

# ─── Storage ─────────────────────────────────────────────────────────────────

# REHEARSAL_DATA_DIR=./data
# REHEARSAL_DB_PATH=./data/rehearsal.db

# Retain session audio after scoring.  Off by default: the transcript and
# findings are what the trainee needs, and audio is the most sensitive artefact
# the system produces.
# REHEARSAL_RETAIN_AUDIO=false

# ─── Application ─────────────────────────────────────────────────────────────

# REHEARSAL_LOG_LEVEL=INFO
# REHEARSAL_API_PORT=8000

# Interface language (independent of the encounter languages).
# REHEARSAL_UI_LOCALE=en

# ─────────────────────────────────────────────────────────────────────────────
# OFFLINE TOOLING ONLY — never used by the running product
# ─────────────────────────────────────────────────────────────────────────────

# Needed once, to download model weights.
# HF_TOKEN=

# Optional.  A frontier model used ONLY as a second opinion during calibration
# analysis, to see where it and the local grader disagree with the human labels.
# It never scores a trainee and is never in the product path.  Leave unset
# unless you are specifically doing that analysis.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
